# SMS India Blog Environment Variables

# Google AdSense Configuration
# Replace with your actual AdSense client ID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# AdSense Ad Slot IDs (replace with your actual slot IDs)
NEXT_PUBLIC_ADSENSE_SLOT_TOP_BANNER=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE_BANNER=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=0000000000

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://smsindiablog.com

# Optional: Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Node Environment
NODE_ENV=production
